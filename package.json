{
  "name": "hinekora",
  "productName": "Hinekora",
  "version": "0.16.0",
  "private": true,
  "description": "Hinekora is a desktop companion app for Path of Exile players who want clean gameplay recording, quick death clips, simple replay editing, and aura overlays",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "build:poe-process-helper": "node scripts/build-poe-process-helper.mjs",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts && vitest run --config vitest.renderer.config.mts",
    "test:main": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts",
    "test:main:media-integration": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts main/modules/editor/__tests__/Editor.ffmpeg.integration.test.ts main/modules/replay-clips/__tests__/ReplayClips.render.integration.test.ts",
    "test:main:coverage": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts --coverage",
    "test:renderer": "vitest run --config vitest.renderer.config.mts",
    "test:renderer:coverage": "vitest run --config vitest.renderer.config.mts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@repere/react": "0.3.3",
    "@sentry/electron": "^7.18.0",
    "@tanstack/react-table": "^9.2.4",
    "immer": "^11.1.18",
    "kysely": "^0.29.5",
    "motion": "^13.2.0",
    "node-addon-api": "^8.9.2",
    "noobs": "0.0.205",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-base": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-rpm": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.37",
    "electron": "^44.3.0",
    "glob": "13.0.6",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  }
}
